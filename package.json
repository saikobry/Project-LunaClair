{
  "name": "project-lunaclair",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "generate:pwa-assets": "pwa-assets-generator public/app-icon.svg --preset minimal",
    "dev:api": "wrangler dev",
    "deploy:api": "wrangler deploy",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:apply:local": "wrangler d1 migrations apply lunaclair --local",
    "db:apply:remote": "wrangler d1 migrations apply lunaclair --remote",
    "seed:materials:local": "node scripts/seed-materials.mjs --local",
    "seed:materials:remote": "node scripts/seed-materials.mjs --remote",
    "seed:catalog:local": "node scripts/seed-catalog.mjs --local",
    "seed:catalog:remote": "node scripts/seed-catalog.mjs --remote",
    "seed:quiz:local": "node scripts/seed-quiz.mjs --local",
    "seed:quiz:remote": "node scripts/seed-quiz.mjs --remote"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@gsap/react": "^2.1.2",
    "@lexical/code": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.102.8",
    "dexie": "^4.4.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "gsap": "^3.15.0",
    "lexical": "^0.49.0",
    "lucide-react": "^1.37.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.62.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^1.0.0-rc.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
