{
  "name": "lunaclair-worker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --root .. worker/src",
    "dev": "cf dev",
    "deploy": "cf deploy",
    "deploy:staging": "cf deploy --mode staging",
    "types": "cf workers types",
    "db:generate": "drizzle-kit generate",
    "db:apply:local": "cf d1 migrations apply c3548105-43de-46f0-9f87-9480d774b808 --local --dir migrations --pattern \"migrations/*/migration.sql\" --persist-to .cloudflare/state",
    "db:apply:production": "cf d1 migrations apply c3548105-43de-46f0-9f87-9480d774b808 --dir migrations --pattern \"migrations/*/migration.sql\"",
    "db:apply:staging": "cf d1 migrations apply 86cbd170-3bc7-4bd1-82d3-b880057ff870 --dir migrations --pattern \"migrations/*/migration.sql\"",
    "db:list:staging": "cf d1 migrations list 86cbd170-3bc7-4bd1-82d3-b880057ff870 --dir migrations --pattern \"migrations/*/migration.sql\""
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "cf": "^1.0.0-beta.18",
    "drizzle-kit": "^1.0.0-rc.4"
  }
}
