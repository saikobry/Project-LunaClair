# Staging preview target — loaded by `vite preview --mode staging`.
#
# `npm run preview`         -> no --mode, so VITE_API_TARGET is unset and vite.config.ts
#                             falls back to https://api.project-lunaclair.workers.dev (production).
# `npm run preview:staging` -> this file, so /api proxies to the STAGING Worker.
#
# api-staging is a separate Worker bound to a separate D1 (lunaclair_staging), so a
# staging preview can never read or write production data.
# See wrangler.jsonc "env.staging" and worker/AGENTS.md.
VITE_API_TARGET=https://api-staging.project-lunaclair.workers.dev