{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  // NOTE: `pages_build_output_dir` is deliberately ABSENT. Cloudflare's Pages
  // build image reads this root config; when that key is present it validates
  // the file as a Pages config and rejects the Worker-only keys `main` and
  // `env.*`, so every Pages build fails with
  // "Configuration file cannot contain both `main` and `pages_build_output_dir`".
  // Verified: master (6beeefe) builds 200 without it; e89b48a and 23385d0 both
  // 404 with it. This file is a WORKER config only — Pages gets its build
  // command and output directory from the dashboard, and no npm script runs
  // `wrangler pages deploy`. Adding it back will silently break Pages again.

  // Comma-separated allowlist of browser origins; empty = local dev defaults.
  "vars": {
    "CORS_ORIGINS": "",
    // AI kill switch: catalog model ids to stop serving (e.g. "ukisai-swift-max"). Empty = all
    // available, including the default model. Takes effect on redeploy.
    "AI_DISABLED_MODELS": "",
    // Global AI emergency shutdown: "true" (or 1/yes/on) stops the assistant entirely — empty
    // catalog, `AI_DISABLED` (503) from chat. Takes effect on redeploy.
    "AI_CHAT_DISABLED": "false"
  },

  // Workers Logs. Declared explicitly because `console` output is **not retained** without it — the
  // AI request telemetry records (`worker/src/ai/telemetry.ts`) are only queryable when the Worker
  // writes them to Workers Logs, and their fields are indexed precisely because the object is logged
  // rather than a stringified line.
  "observability": {
    "enabled": true
  },

  // Cloudflare D1 (serverless SQLite) — the cloud sync layer for LunaClair.
  // The browser can never reach D1 directly; this Worker is the only bridge.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunaclair",
      "database_id": "c3548105-43de-46f0-9f87-9480d774b808",
      "migrations_dir": "worker/migrations",
      // Drizzle v1 writes each migration as its own subdirectory (e.g. 0001_init/migration.sql).
      "migrations_pattern": "worker/migrations/*/migration.sql"
    }
  ],

  // Cloudflare Workers AI binding for serverless edge inference.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Staging — a SEPARATE Worker bound to a SEPARATE D1 database.
  //
  // `wrangler deploy` (no --env) targets the top level above: production.
  // `wrangler deploy --env staging` targets this block, deploying Worker
  // `api-staging` at api-staging.<subdomain>.workers.dev against D1
  // `lunaclair_staging`. Nothing here touches production.
  //
  // Bindings and vars are NON-INHERITABLE, so `vars`, `d1_databases` and `ai`
  // are repeated deliberately rather than inherited — change one, change both.
  "env": {
    "staging": {
      "name": "api-staging",
      "compatibility_date": "2026-07-30",
      "compatibility_flags": ["nodejs_compat"],
      "vars": {
        "CORS_ORIGINS": "",
        "AI_DISABLED_MODELS": "",
        "AI_CHAT_DISABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lunaclair_staging",
          "database_id": "86cbd170-3bc7-4bd1-82d3-b880057ff870",
          "migrations_dir": "worker/migrations",
          "migrations_pattern": "worker/migrations/*/migration.sql"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      }
    }
  }
}
