{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",

  // Comma-separated allowlist of browser origins; empty = local dev defaults.
  "vars": {
    "CORS_ORIGINS": "",
    // AI kill switch: catalog model ids to stop serving (e.g. "ukisai-swift-max"). Empty = all
    // available, including the default model. Takes effect on redeploy.
    "AI_DISABLED_MODELS": "",
    // Global AI emergency shutdown: "true" (or 1/yes/on) stops the assistant entirely — empty
    // catalog, `AI_DISABLED` (503) from chat. Takes effect on redeploy.
    "AI_CHAT_DISABLED": "false"
  },

  // Cloudflare D1 (serverless SQLite) — the cloud sync layer for LunaClair.
  // The browser can never reach D1 directly; this Worker is the only bridge.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunaclair",
      "database_id": "c3548105-43de-46f0-9f87-9480d774b808",
      "migrations_dir": "worker/migrations",
      // Drizzle v1 writes each migration as its own subdirectory (e.g. 0001_init/migration.sql).
      "migrations_pattern": "worker/migrations/*/migration.sql"
    }
  ],

  // Cloudflare Workers AI binding for serverless edge inference.
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
